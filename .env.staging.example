# Staging / production environment (E0.6). Copy to .env.staging ON THE SERVER, fill it in, then:
#
#   chmod 600 .env.staging
#   python3 scripts/check_env_staging.py            # must print OK
#   docker compose --env-file .env.staging -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# .env.staging is never committed (it is in .gitignore) and never copied from your laptop's .env:
# every secret below must be NEW and different from the local one. Values are intentionally empty here.

# ─── Required ──────────────────────────────────────────────────────────

# Domain of the server (A record must already point to the VPS). Host name only: no https://, port or path.
DOMAIN=
# E-mail for Let's Encrypt expiry notices.
ACME_EMAIL=

# JWT signing key. NEW, at least 32 characters, never a value published in this repository
# (the app refuses to start otherwise). Generate on the server:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL. NEW, long password (at least 32 characters, not the local one, not equal to SECRET_KEY):
#   python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ─── LLM providers (optional until E0.7; own keys, never the ones from a personal .env) ──
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── Optional ───────────────────────────────────────────────────────────

# Let's Encrypt directory. Empty = production. For the FIRST run use the staging directory to avoid rate limits
# (the certificate is then not trusted by browsers), then clear it and redeploy:
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=

# Memory limits (defaults fit a 4 GB VPS; raise them on 8 GB, e.g. BACKEND_MEM_LIMIT=3g, DB_MEM_LIMIT=1g).
DB_MEM_LIMIT=
REDIS_MEM_LIMIT=
REDIS_MAXMEMORY=
BACKEND_MEM_LIMIT=
FRONTEND_MEM_LIMIT=
CADDY_MEM_LIMIT=
