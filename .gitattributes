# Normalize line endings: text files are stored as LF in the repo.
* text=auto

*.py   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.js   text eol=lf
*.vue  text eol=lf
*.json text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf

# Windows scripts keep CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.ico  binary
