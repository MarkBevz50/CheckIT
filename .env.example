# ─── CheckIT environment ────────────────────────────────
# Copy this file to .env (repo root) and fill in values.
# The backend reads configuration only via back-end/app/core/config.py (Settings).
# Variables marked REQUIRED have no default: the app will not start without them.

# PostgreSQL (used by the `db` container; docker-compose builds DATABASE_URL from these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=check_it

# REQUIRED when running the backend outside Docker (compose sets it for you):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/check_it

# REQUIRED. JWT signing key, no fallback. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Log every SQL statement (default: false)
# DB_ECHO=false

# JWT algorithm (default: HS256) and CORS origin of the frontend
# ALGORITHM=HS256
# FRONTEND_URL=http://localhost:5173

# Anthropic Claude (primary LLM — enables AI validation & risk analysis)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-haiku-4.5
# ANTHROPIC_MODEL_SMART=claude-sonnet-4.6

# Google Gemini API (fallback LLM, optional) and its model rotation list
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite

# Hugging Face (assistant chat, optional; to be removed in E6.6)
# HUGGINGFACE_API_KEY=

# Redis cache (docker-compose sets REDIS_URL; empty = caching disabled) and TTL in seconds
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL_SECONDS=7200
